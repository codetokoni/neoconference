# Copy to .env and fill in.
# See README.md for how to get each value.

# --- LiveKit project (matches the NeoConference Next.js env vars) ------
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxxxxxxxxx
LIVEKIT_API_SECRET=your_livekit_api_secret_here

# --- Deepgram ----------------------------------------------------------
# Get one at https://console.deepgram.com/. If yesterday's captions
# stopped working out of nowhere, this key is the most common culprit
# (rotated or its pay-as-you-go balance ran out).
DEEPGRAM_API_KEY=your_deepgram_key_here

# --- Agent registration ------------------------------------------------
# MUST match CAPTIONS_AGENT_NAME on the NeoConference Next.js side
# (defaults to "neo-captions" in src/app/api/livekit/captions/dispatch/route.ts).
# Only change this if you're running a second worker for testing next to
# a live one.
AGENT_NAME=neo-captions

# --- Deepgram tuning (optional) ----------------------------------------
# nova-2 is a good default; nova-3 for higher accuracy at higher cost.
DEEPGRAM_MODEL=nova-2
# "multi" auto-detects language per utterance. Set a specific BCP-47
# tag (en, es, fr, de …) for a single-language room.
DEEPGRAM_LANGUAGE=multi
