# =============================================================================
# NeoConference — Environment Variables
# Copy this file to .env.local and fill in the values for local development.
# In production, set these in the Vercel dashboard (Project → Settings → Environment Variables).
# =============================================================================

# -----------------------------------------------------------------------------
# Clerk — Authentication (https://dashboard.clerk.com -> API keys)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional Clerk redirect overrides
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# -----------------------------------------------------------------------------
# LiveKit — Real-time video (https://cloud.livekit.io -> Settings -> Keys)
# -----------------------------------------------------------------------------
LIVEKIT_API_KEY=APIxxxxxxxxxxxxx
LIVEKIT_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_LIVEKIT_URL=wss://your-project.livekit.cloud

# -----------------------------------------------------------------------------
# S3-compatible object storage (Cloudflare R2 / AWS S3) — recordings & assets
# -----------------------------------------------------------------------------
S3_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxx
S3_SECRET_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
S3_BUCKET=neoconference
S3_REGION=auto

# -----------------------------------------------------------------------------
# Vercel KV / Upstash Redis — sessions, rate limiting, cache
# (Auto-injected by Vercel KV integration; set manually for local dev.)
# -----------------------------------------------------------------------------
REDIS_URL=rediss://default:xxxxxxxx@xxxxxx.upstash.io:6379
KV_URL=rediss://default:xxxxxxxx@xxxxxx.upstash.io:6379
KV_REST_API_URL=https://xxxxxx.upstash.io
KV_REST_API_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
KV_REST_API_READ_ONLY_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# -----------------------------------------------------------------------------
# KingsChat OAuth (custom SSO via Clerk Enterprise Connection)
# -----------------------------------------------------------------------------
KINGSCHAT_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
KINGSCHAT_REDIRECT_URI=https://your-domain.com/api/auth/kingschat/callback
KINGSCHAT_STATE_SECRET=replace-with-a-long-random-string

# -----------------------------------------------------------------------------
# ESPEES — payments / merchant wallet
# -----------------------------------------------------------------------------
ESPEES_MERCHANT_WALLET=your-espees-wallet-address
# Required for eSPees v2 product-checkout API (sent as x-api-key header).
ESPEES_API_KEY=your-espees-api-key
# Numeric product IDs from your eSPees merchant dashboard product catalog.
# Sent as `product_sku` in the v2 product-checkout request body.
ESPEES_PRO_SKU=your-pro-product-id
ESPEES_BUSINESS_SKU=your-business-product-id

# -----------------------------------------------------------------------------
# Bootstrap admin / business contact emails (used on first deploy seed)
# -----------------------------------------------------------------------------
BOOTSTRAP_ADMIN_EMAIL=admin@your-domain.com
BOOTSTRAP_BUSINESS_EMAIL=business@your-domain.com

# -----------------------------------------------------------------------------
# Permanent admins (comma-separated, case-insensitive). These emails are
# treated as app-wide admin AND auto-promoted to "host" of any room they
# join, regardless of who owns the event. Also bypass free-plan limits
# (treated as "business" tier). Authority lives in this env var — removing
# an email here revokes admin on the next request (NOT persisted to Clerk).
# Never commit real emails. Set in Vercel project env (Production + Preview).
# -----------------------------------------------------------------------------
ADMIN_EMAILS=admin1@your-domain.com,admin2@your-domain.com

# -----------------------------------------------------------------------------
# Simulcast — /video/dashboard (Ant Media on StreamLab)
# -----------------------------------------------------------------------------
# Main track id. Every publisher pushes with ?mainTrack=<this value>, and the
# per-language stream ids in src/lib/simulcast.ts are derived from it.
NEXT_PUBLIC_SIMULCAST_MAIN=neoconf
# Ant Media WebRTC signalling + HTTP origin (browser-facing).
NEXT_PUBLIC_AMS_WS=wss://your-ams-host/LiveApp/websocket
NEXT_PUBLIC_AMS_HTTP=https://your-ams-host/LiveApp
# Server-side only: /api/video/status calls this so the browser never talks to
# the ingest host directly. Set in Vercel project env (Production + Preview).
AMS_REST_BASE=https://your-ams-host/LiveApp/rest/v2
