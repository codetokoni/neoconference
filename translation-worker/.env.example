# Copy to .env on the droplet and fill in real values.

# AMS HTTP base — same value NEXT_PUBLIC_AMS_HTTP uses in Vercel.
# The worker builds ${AMS_HTTP}/streams/<room>-video.m3u8 per room at
# request time; no room list is baked into config.
AMS_HTTP=https://ingest.streamlab.cloud/LiveApp

# Deepgram Live STT. Use a project-scoped key; rotate if it leaks.
DEEPGRAM_API_KEY=

# DeepL. Key ending in :fx uses the Free tier at api-free.deepl.com.
DEEPL_API_KEY=

# Comma-separated language slugs. Must match the codes in the app's
# SimulcastChannel template (fr / es / pt / ar).
TARGET_LANGS=fr,es,pt,ar

# Source language of the programme feed.
SOURCE_LANG=en

# Port the SSE server binds to. Terminate TLS in front of it (Caddy,
# Cloudflare, nginx) — browsers refuse EventSource over plain HTTP from
# an HTTPS page.
SSE_PORT=8080

# How long to keep a room's ffmpeg+Deepgram pipeline warm after its
# last SSE subscriber disconnects. Short enough that a truly abandoned
# room stops billing Deepgram/DeepL within a minute; long enough to
# survive a tab reload without paying reconnection latency.
IDLE_GRACE_MS=60000

# --- Alerting (optional) -----------------------------------------
# When >= ALERT_ERROR_THRESHOLD DeepL errors land in a 60-second
# window for the same room, the worker posts a one-line message to
# SLACK_ALERT_WEBHOOK (Slack incoming webhook, Discord webhook, or
# any URL that accepts { text: "..." } POSTs). Debounced so an
# outage doesn't spam the channel — one message per
# ALERT_DEBOUNCE_MS per room.
# SLACK_ALERT_WEBHOOK=https://hooks.slack.com/services/AAA/BBB/CCC
# ALERT_ERROR_THRESHOLD=5
# ALERT_DEBOUNCE_MS=600000
