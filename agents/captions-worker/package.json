{
  "name": "neoconference-captions-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "LiveKit Agents worker that streams meeting audio to Deepgram and publishes live transcriptions back into the room.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js start",
    "dev": "tsx watch src/index.ts dev"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@livekit/agents": "1.4.1",
    "@livekit/agents-plugin-deepgram": "1.4.1",
    "@livekit/rtc-node": "0.13.28",
    "livekit-server-sdk": "2.15.2",
    "dotenv": "16.4.5"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "@types/node": "^20.14.0"
  },
  "overrides": {
  "@livekit/rtc-node": "0.13.28"
  }
}
