# agents/captions-worker/.env.example
#
# Copy to .env (local dev) or set as Railway service env vars.

# LiveKit Cloud (same project as the Next.js app).
# LIVEKIT_URL is the wss:// URL, NOT the https:// dashboard URL.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxxxxxxxxxxx
LIVEKIT_API_SECRET=secretxxxxxxxxxxxxxxxx

# Deepgram streaming key. Use a key SEPARATE from the one used for
# post-meeting batch transcription in the Next.js app so streaming costs are
# isolated and can be capped independently in the Deepgram dashboard.
DEEPGRAM_API_KEY_STREAMING=

# Optional: set agent name so the dispatch API can target this worker by
# name. If unset the worker will accept any unnamed dispatch.
AGENT_NAME=neo-captions

# Optional log level
LOG_LEVEL=info
