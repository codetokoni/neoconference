<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- A meeting needs the camera, the microphone and the network. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS"/>
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT"/>
    <!-- Lets a meeting notice a phone call and mute itself, so the call and
         its ringtone are not broadcast into the meeting. Android 12+
         requires it for call-state callbacks; without it the app simply
         does not watch — it never falls back to guessing from the audio
         mode, which was measured to go stale after a call ends. -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE"/>

    <!-- Keeps the call alive when the phone is put down or another app is
         opened. Android kills a backgrounded process that publishes media
         without one of these. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE"/>
    <!-- The baseline type for a meeting. Someone muted is listening, not
         capturing, and the microphone type cannot be claimed until
         RECORD_AUDIO has actually been granted at runtime — Android checks
         the grant, not this declaration, and throws out of startForeground
         if it is missing. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- An incoming group call vibrates like a phone call (IncomingRinger). -->
    <uses-permission android:name="android.permission.VIBRATE"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>

    <!-- Cameras and microphones are not required: someone can join to watch
         and listen from a device that has neither. -->
    <uses-feature android:name="android.hardware.camera" android:required="false"/>
    <uses-feature android:name="android.hardware.microphone" android:required="false"/>

    <application
        android:label="NeoConference"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:supportsPictureInPicture="true"
            android:resizeableActivity="true"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>

            <!-- Signing in with KingsChat or Neomail happens in the phone's
                 browser, which hands control back here carrying the Clerk
                 sign-in ticket.

                 An App Link, deliberately not a custom scheme:
                 android:autoVerify makes Android fetch
                 https://www.neoconference.app/.well-known/assetlinks.json and
                 confirm that this domain names the certificate this app is
                 signed with. Until that check passes, the link opens in a
                 browser instead. A custom scheme has no such check — any
                 installed app could have claimed it and received the sign-in
                 ticket, which is an account takeover, so this app has never
                 registered one since release signing landed.

                 The server only ever redirects to this one exact URL; see
                 src/lib/app-callback.ts. -->
            <!-- Meeting links open in the app for anyone who has it: the
                 meeting page (/e/<slug>) and the room (/room/<room>). The
                 same assetlinks.json verifies them. Short links
                 (/<slug>) cannot be claimed without claiming every page
                 on the site; the web offers "Open in the app" on those.
                 pathAdvancedPattern (Android 12+) keeps /e/<slug>/replay,
                 a page to watch, in the browser. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="https" android:host="www.neoconference.app"/>
                <data android:pathAdvancedPattern="/e/[^/]+"/>
                <data android:pathAdvancedPattern="/room/[^/]+"/>
                <!-- Group invite links: /groups/join/<token>. -->
                <data android:pathAdvancedPattern="/groups/join/[^/]+"/>
            </intent-filter>
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data
                    android:scheme="https"
                    android:host="www.neoconference.app"
                    android:path="/app/auth"/>
            </intent-filter>
        </activity>

        <!-- Screen sharing runs in flutter_webrtc's own foreground service,
             which its manifest declares and the build merges in. The
             mediaProjection permission above is what that service needs;
             declaring the service here as well would only conflict with it. -->

        <!-- What keeps the call alive when the app is not on screen.
             Android stops scheduling a backgrounded process within seconds
             and kills one capturing a microphone without a service of this
             exact type. The permissions above have been declared since the
             app shipped; nothing started a service until now. -->
        <service
            android:name=".MeetingService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback|microphone|mediaProjection" />

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!-- KingsChat login (developers.kingschat.online/docs/mobile): the
             client id of the Android application registered on the
             KingsChat console for this package and signing certificate. -->
        <meta-data
            android:name="com.kingschat.sdk.ApplicationId"
            android:value="0dcd6e74-a404-4372-b399-dc2193679135" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- url_launcher opens the sign-in page in a browser. -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
        <!-- KingsChat login asks the installed KingsChat app to authorise
             us. Without this, Android 11+ hides the app from us and the
             sign-in looks as though KingsChat were not installed. -->
        <package android:name="com.joinkingschat.android"/>
    </queries>
</manifest>
